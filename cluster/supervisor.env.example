# cp supervisor.env.example supervisor.env   (gitignored) and rerun bootstrap.yml: it lands on the
# root as /home/pi/supervisor.env, read by dllama-supervisor.service via EnvironmentFile=.
# Blank values are fine; every feature below is off without one.

# Sentry logs + cluster-state issues from supervisor.py (needs apt python3-sentry-sdk, installed by bootstrap)
SENTRY_DSN=
SENTRY_ENVIRONMENT=demo

# POST /restart from anywhere but the root itself must send "Authorization: Bearer <token>"
SUPERVISOR_TOKEN=
