[Unit]
Description=distributed-llama root API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/distributed-llama
ExecStart=/home/pi/distributed-llama/dllama-api \
    --host 0.0.0.0 \
    --port 9990 \
    --model /home/pi/distributed-llama/models/qwen3_0.6b_q40/dllama_model_qwen3_0.6b_q40.m \
    --tokenizer /home/pi/distributed-llama/models/qwen3_0.6b_q40/dllama_tokenizer_qwen3_0.6b_q40.t \
    --buffer-float-type q80 \
    --nthreads 4 \
    --workers pi-node-1.local:9998

Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
