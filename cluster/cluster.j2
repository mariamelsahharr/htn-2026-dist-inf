{% set worker_addrs = worker_addrs | default('192.168.50.11,192.168.50.12,192.168.50.14') %}
#!/usr/bin/env bash
# Rendered by cluster/bootstrap.yml from cluster/cluster.j2; edit the template or inventory.ini, not this file.
set -euo pipefail

# Wired worker addresses, [workers] inventory order (the supervisor's priority order).
WORKERS=(
{% for addr in worker_addrs.split(',') %}
  "{{ addr }}"
{% endfor %}
)
# A dead worker must not hang the wrapper: no password prompts, 5 s to connect.
SSH_OPTS=(-o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=accept-new)

# dllama-supervisor launches dllama-api itself and handles 4 -> 2 -> 1 failover.
# ROOT_UNIT=dllama-root ./cluster up   is the one-command rollback to the plain root.
ROOT_UNIT="${ROOT_UNIT:-dllama-supervisor}"

case "${1:-}" in
  up)
    echo "Starting workers..."
    for host in "${WORKERS[@]}"; do
      ssh "${SSH_OPTS[@]}" "pi@$host" "sudo systemctl start dllama-worker" || echo "warn: $host not started (supervisor will run without it)"
    done

    sleep 2

    echo "Starting root ($ROOT_UNIT)..."
    sudo systemctl start "$ROOT_UNIT"
    ;;

  down)
    echo "Stopping root ($ROOT_UNIT)..."
    sudo systemctl stop "$ROOT_UNIT" || true

    echo "Stopping workers..."
    for host in "${WORKERS[@]}"; do
      ssh "${SSH_OPTS[@]}" "pi@$host" "sudo systemctl stop dllama-worker" || true
    done
    ;;

  restart)
    "$0" down
    sleep 2
    "$0" up
    ;;

  status)
    echo "=== ROOT ($ROOT_UNIT) ==="
    systemctl --no-pager status "$ROOT_UNIT" | head -n 8 || true
    if [ "$ROOT_UNIT" = "dllama-supervisor" ]; then
      curl -s -m 2 http://127.0.0.1:9991/status \
        | python3 -c 'import json,sys; s=json.load(sys.stdin); print("cluster:", s["state"], "-", s["reason"]); print("active:", ", ".join(s["active_workers"]) or "root only")' \
        || echo "supervisor status endpoint not answering"
    fi

    for host in "${WORKERS[@]}"; do
      echo
      echo "=== $host ==="
      ssh "${SSH_OPTS[@]}" "pi@$host" "systemctl --no-pager status dllama-worker | head -n 8" || true
    done
    ;;

  *)
    echo "Usage: $0 {up|down|restart|status}"
    exit 1
    ;;
esac
