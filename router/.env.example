# router/.env.example - copy to .env and fill in. .env is gitignored.
#
#   cp .env.example .env
#   uvicorn app:app --host 0.0.0.0 --port 8000   # or: python app.py
#
# app.py loads .env itself. Real environment variables override the file, so
# `unset` a stale export if a value here seems to be ignored.

# --- upstreams ---------------------------------------------------------------

# Topology: pi-node-3 = root/API, pi-node-1/2/4 = workers, pi-node-5 = router
# (this box). Point this at the ROOT's OpenAI-compatible API on 9990 - never a
# worker, which listens on 9998 and serves no HTTP.
# Confirm the root's wired address once:
#   curl -s -m 2 http://pi-node-3.local:9990/v1/models
LOCAL_BASE_URL=http://192.168.50.13:9990

CLOUD_BASE_URL=https://inference.baseten.co/v1
BASETEN_API_KEY=
# CLOUD_API_KEY= is accepted as an alias for BASETEN_API_KEY.

# Model ids. LOCAL_MODEL is what the cluster is loaded with and what clients
# ask for; append -heavy / -big / -cloud to it to force escalation.
LOCAL_MODEL=llama-3.2-3b-instruct
CLOUD_MODEL=zai-org/GLM-5.3-Fast

# --- cluster health ----------------------------------------------------------

# The supervisor's status JSON. Runs on the root node. Not built yet, so the
# next setting still matters.
STATUS_URL=http://192.168.50.13:9991/status

# 1 = when no supervisor answers, treat the cluster as healthy (usable before
# the supervisor exists). Set to 0 once it is live, or health-based failover
# can never fire.
ASSUME_HEALTHY_IF_NO_STATUS=1
STATUS_INTERVAL=2

# --- policy ------------------------------------------------------------------

# prompt_tokens + max_tokens above this escalates to the cloud.
SIZE_THRESHOLD=2048

# --- timeouts (seconds) ------------------------------------------------------

# Time to the first real token before the upstream is written off. Nothing has
# reached the client yet at that point, so the retry is invisible.
FIRST_TOKEN_TIMEOUT=8
READ_TIMEOUT=60
CONNECT_TIMEOUT=3

# --- demo safety net ---------------------------------------------------------

# 1 = serve pre-generated answers from CACHE_FILE when both upstreams fail.
# Build it with: ./warm_cache.py --prompts demo_prompts.txt --url <router>/v1/chat/completions
DEMO_FALLBACK=1
CACHE_FILE=demo_cache.json
DECISION_LOG=routing_decisions.jsonl

# Only used by `python app.py`; uvicorn takes --port instead.
PORT=8000
