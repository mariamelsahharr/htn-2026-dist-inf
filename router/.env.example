# router/.env.example - copy to .env and fill in. .env is gitignored.
#
#   cp .env.example .env
#   uvicorn app:app --host 0.0.0.0 --port 8000
#
# app.py reads this file via pydantic-settings. Real environment variables win
# over it, so `unset` a stale export if a value here seems to be ignored.
# Field name in Settings == env var name; anything omitted uses the default.

# --- topology ----------------------------------------------------------------
# pi-node-3 = root / API / supervisor   (192.168.50.13)
# pi-node-1, -2, -4 = workers           (.11, .12, .14, port 9998, no HTTP)
# pi-node-5 = this router
#
# LOCAL_BASE_URL must point at the ROOT, never at a worker and never at this box.
LOCAL_BASE_URL=http://192.168.50.13:9990
LOCAL_MODEL=llama-3.2-3b-instruct

# The supervisor's status JSON. Also on the root. When it is unreachable the
# router probes the root API directly instead of assuming.
STATUS_URL=http://192.168.50.10:9991/status
STATUS_INTERVAL=2
# A status poll that times out keeps the last verdict this many seconds before the cluster
# is declared unreachable: one dropped poll on a lossy link is not a dead cluster.
STATUS_GRACE_S=10

# --- cloud tiers -------------------------------------------------------------
# A tier exists only when it has BOTH a key and a model. Baseten is the primary.
CLOUD_BASE_URL=https://inference.baseten.co/v1
BASETEN_API_KEY=
CLOUD_MODEL=zai-org/GLM-5.3-Fast
# CLOUD_API_KEY= is an accepted alias for BASETEN_API_KEY.

# Optional extra tiers. Leave blank to disable; each needs key + model.
OPENAI_API_KEY=
OPENAI_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_MODEL=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
SNOWFLAKE_API_KEY=
SNOWFLAKE_MODEL=
SNOWFLAKE_BASE_URL=

# Fallback order across cloud tiers. Unconfigured tiers are skipped.
CLOUD_TIER_ORDER=baseten,gemini,openai,snowflake

# Pin requests that carry tool definitions to one tier (e.g. openai). Blank = off.
TOOL_TIER=

# --- policy ------------------------------------------------------------------
# prompt_tokens + max_tokens above this escalates to the cloud. The cluster runs with a
# 4096-token context, so the default is "does it fit", with margin for the estimate.
SIZE_THRESHOLD=3584
# Only the outliers count as too complex for the local model: this many fenced code
# lines, or this many messages in one conversation.
CODE_LINES_THRESHOLD=400
MAX_LOCAL_TURNS=40

# --- timeouts (seconds) ------------------------------------------------------
# Time to the first real token before an upstream is written off. Nothing has
# reached the client yet at that point, so the retry is invisible.
FIRST_TOKEN_TIMEOUT=8
READ_TIMEOUT=60
CONNECT_TIMEOUT=3

# --- demo safety net ---------------------------------------------------------
# Serve pre-generated answers when every upstream fails. Build the file with:
#   ./warm_cache.py --prompts demo_prompts.txt --url http://pi-node-5.local:8000/v1/chat/completions
DEMO_FALLBACK=1
CACHE_FILE=demo_cache.json
DECISION_LOG=routing_decisions.jsonl
